# clean-cars-api — PROD (Dokploy → Environment tab)
# Runtime env vars. Dummy values below.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8089

# Database
DB_URL=jdbc:mysql://mysql-prod:3306/cleancars
DB_USERNAME=cleancars_app
#Place real keys here
DB_PASSWORD=change-me-db-password

# JWT signing keys: HS256, >= 32 characters, different from each other
#Place real keys here
JWT_SECRET=dummy-jwt-secret-prod-0123456789abcdef
#Place real keys here
INTERNAL_JWT_SECRET=dummy-internal-jwt-secret-prod-0123456789
JWT_TTL_SECONDS=900

# Firebase (project id only, not a secret)
FIREBASE_PROJECT_ID=clean-cars-api

# Razorpay (LIVE keys)
#Place real keys here
RAZORPAY_KEY_ID=rzp_live_dummyKeyId123
#Place real keys here
RAZORPAY_KEY_SECRET=dummyRazorpayKeySecret
#Place real keys here
RAZORPAY_WEBHOOK_SECRET=dummyRazorpayWebhookSecret

# Twilio Verify (phone OTP)
#Place real keys here
TWILIO_ACCOUNT_SID=ACdummydummydummydummydummydummy12
#Place real keys here
TWILIO_AUTH_TOKEN=dummyTwilioAuthToken
#Place real keys here
TWILIO_VERIFY_SERVICE_SID=VAdummydummydummydummydummydummy12

# Comma-separated origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=https://app.example.com,https://internal.example.com

# Optional
DB_POOL_MAX=20
