# clean-cars-api — TEST (Dokploy → Environment tab)
# Runtime env vars. Dummy values below.

SPRING_PROFILES_ACTIVE=stage
SERVER_PORT=8080

# Database
DB_URL=jdbc:mysql://mysql-test:3306/cleancars
DB_USERNAME=cleancars_app
#Place real keys here
DB_PASSWORD=change-me-db-password

# JWT signing keys: HS256, >= 32 characters, different from each other
#Place real keys here
JWT_SECRET=dummy-jwt-secret-test-0123456789abcdef
#Place real keys here
INTERNAL_JWT_SECRET=dummy-internal-jwt-secret-test-0123456789
JWT_TTL_SECONDS=3600

# Firebase (project id only, not a secret)
FIREBASE_PROJECT_ID=clean-cars-api

# Razorpay (use TEST-mode keys)
#Place real keys here
RAZORPAY_KEY_ID=rzp_test_dummyKeyId123
#Place real keys here
RAZORPAY_KEY_SECRET=dummyRazorpayKeySecret
#Place real keys here
RAZORPAY_WEBHOOK_SECRET=dummyRazorpayWebhookSecret

# Twilio Verify (phone OTP)
#Place real keys here
TWILIO_ACCOUNT_SID=ACdummydummydummydummydummydummy12
#Place real keys here
TWILIO_AUTH_TOKEN=dummyTwilioAuthToken
#Place real keys here
TWILIO_VERIFY_SERVICE_SID=VAdummydummydummydummydummydummy12

# Comma-separated origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=https://test-app.example.com,https://test-internal.example.com

# Optional
DB_POOL_MAX=10
